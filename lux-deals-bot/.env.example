# Токен Telegram-бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Duffel API (живые цены на авиабилеты): https://app.duffel.com -> Developers -> Access tokens
# Без токена бот работает в демо-режиме на вымышленных ценах.
DUFFEL_TOKEN=

# seats.aero Partner API (места за мили), нужна подписка Pro: https://seats.aero/apikey
SEATS_AERO_KEY=

# Как часто проверять подписки, минуты
CHECK_INTERVAL_MIN=180
# Сколько дат из диапазона проверять за один проход (ограничивает число запросов)
MAX_DATES_PER_WATCH=4
# Сделка = цена ниже этой доли от медианы истории (0.7 = на 30% дешевле обычного)
DEAL_THRESHOLD=0.7
# Минимальная экономия позиционного перелёта, доля (0.15 = 15%)
POSITIONING_MIN_SAVING=0.15
# Хабы для позиционных перелётов через запятую (пусто = список по умолчанию)
POSITIONING_HUBS=
# Максимум миль, при котором award-место считается находкой
AWARD_MAX_MILES_BUSINESS=90000
AWARD_MAX_MILES_FIRST=130000

DB_PATH=data/bot.db
